---
import Base from "../layouts/Base.astro";
import HuntToday from "../components/HuntToday.astro";
import { CONDITIONS, MONTHS } from "../data/hunting-calendar";
import { rowsForMonth } from "../lib/hunting";
import { sitePath } from "../lib/paths";

const months = MONTHS.map((month) => ({
  ...month,
  rows: rowsForMonth(month.number),
}));
---

<Base
  title="Kalendarz polowań"
  description="Okresy polowań w województwie podlaskim dla Koła Łowieckiego Przepiórka."
  path="/kalendarz/"
>
  <div class="wrap page-head">
    <h1>Kalendarz polowań</h1>
    <p>
      Okresy dla województwa podlaskiego. Wyjątki dolnośląskie, lubuskie, opolskie, pomorskie, wielkopolskie,
      zachodniopomorskie i kujawsko-pomorskie są pominięte.
    </p>
  </div>

  <section class="section" style="padding-top: 0.5rem">
    <div class="wrap hunt-calendar">
      <HuntToday />

      <div class="hunt-tabs" role="tablist" aria-label="Miesiące">
        {
          months.map((month) => (
            <a href={`#${month.id}`} data-month-tab={month.number} role="tab">
              {month.name}
            </a>
          ))
        }
      </div>

      {
        months.map((month) => (
          <section class="hunt-month" id={month.id} data-month={month.number} role="tabpanel">
            <h2>{month.name}</h2>
            <ul class="hunt-list">
              {month.rows.map((row) => (
                <li class="hunt-row">
                  <span class="hunt-icons">
                    {row.icons.map((icon) => (
                      <img src={sitePath(icon.src)} alt={icon.alt} width="50" height="50" />
                    ))}
                  </span>
                  <span>
                    <h3>{row.name}</h3>
                    {row.detail && <p class="hunt-detail">{row.detail}</p>}
                    <ul class="hunt-parts">
                      {row.parts.map((part) => (
                        <li>
                          {part.who && <strong>{part.who}</strong>}
                          <span>{part.text}</span>
                          {part.condition && <small>{CONDITIONS[part.condition]}</small>}
                        </li>
                      ))}
                    </ul>
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <script is:inline>
    const tabs = [...document.querySelectorAll("[data-month-tab]")];
    const panels = [...document.querySelectorAll("[data-month]")];
    const fromHash = panels.find((panel) => panel.id === location.hash.slice(1));
    function showMonth(month) {
      for (const panel of panels) panel.hidden = panel.dataset.month !== month;
      for (const tab of tabs) {
        const on = tab.dataset.monthTab === month;
        tab.setAttribute("aria-current", on ? "true" : "false");
        tab.setAttribute("aria-selected", on ? "true" : "false");
      }
    }
    showMonth(fromHash?.dataset.month || String(new Date().getMonth() + 1));
    for (const tab of tabs) {
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        showMonth(tab.dataset.monthTab);
        const panel = panels.find((item) => item.dataset.month === tab.dataset.monthTab);
        if (panel) history.replaceState(null, "", `#${panel.id}`);
      });
    }
  </script>
</Base>
