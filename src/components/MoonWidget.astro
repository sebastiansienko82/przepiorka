<section class="section moon-section" style="padding-top: 0" aria-labelledby="fazy-ksiezyca">
  <div class="wrap">
    <h2 id="fazy-ksiezyca" class="section-title">Fazy księżyca</h2>
    <div class="moon-widget" data-moon-widget>
      <div class="moon-stage" data-moon-stage aria-hidden="true"></div>
      <div class="moon-copy">
        <p class="kicker">Dziś</p>
        <p class="moon-date" data-moon-date></p>
        <p class="moon-name" data-moon-name></p>
        <p class="moon-detail" data-moon-detail></p>
        <p class="moon-sun" data-moon-sun></p>
        <p class="moon-sun-place">dla Białegostoku</p>
      </div>
      <div class="moon-aside">
        <p class="moon-next-label">Najbliższe fazy</p>
        <ol class="moon-upcoming" data-moon-upcoming></ol>
      </div>
    </div>
  </div>
</section>

<script>
  import { moonLitPath, moonNow, upcomingPhases } from "../lib/moon";

  const root = document.querySelector<HTMLElement>("[data-moon-widget]");
  const stage = root?.querySelector<HTMLElement>("[data-moon-stage]");
  const date = root?.querySelector<HTMLElement>("[data-moon-date]");
  const name = root?.querySelector<HTMLElement>("[data-moon-name]");
  const detail = root?.querySelector<HTMLElement>("[data-moon-detail]");
  const sun = root?.querySelector<HTMLElement>("[data-moon-sun]");
  const list = root?.querySelector<HTMLOListElement>("[data-moon-upcoming]");

  function moonImage(phase: number): string {
    const size = 200;
    const canvas = document.createElement("canvas");
    canvas.width = size;
    canvas.height = size;
    const ctx = canvas.getContext("2d");
    if (!ctx) return "";
    const cx = size / 2;
    const cy = size / 2;
    const radius = size * 0.46;
    ctx.beginPath();
    ctx.arc(cx, cy, radius, 0, Math.PI * 2);
    ctx.fillStyle = "#2a312c";
    ctx.fill();
    const lit = moonLitPath(phase, cx, cy, radius);
    if (lit) {
      const glow = ctx.createRadialGradient(cx - radius * 0.32, cy - radius * 0.36, radius * 0.08, cx, cy, radius);
      glow.addColorStop(0, "#fff9ec");
      glow.addColorStop(0.46, "#f3e4c0");
      glow.addColorStop(1, "#c6a86a");
      ctx.fillStyle = glow;
      ctx.fill(new Path2D(lit));
    }
    return canvas.toDataURL("image/png");
  }

  function sunPart(label: string, value: string, iso: string): HTMLSpanElement {
    const part = document.createElement("span");
    part.append(document.createTextNode(`${label} `));
    const time = document.createElement("time");
    time.dateTime = iso;
    time.textContent = value;
    part.append(time);
    return part;
  }

  if (root && stage && date && name && detail && sun && list) {
    const now = new Date();
    const sky = moonNow(now);
    const disc = document.createElement("span");
    disc.className = "moon-disc";
    disc.style.backgroundImage = `url("${moonImage(sky.phase)}")`;
    stage.replaceChildren(disc);
    date.textContent = sky.dateLabel;
    name.textContent = sky.name;
    detail.textContent = sky.detailLabel;
    sun.replaceChildren(
      sunPart("Wschód słońca", sky.sunriseLabel, sky.sunriseIso),
      sunPart("Zachód słońca", sky.sunsetLabel, sky.sunsetIso),
    );
    list.replaceChildren(
      ...upcomingPhases(now).map((event) => {
        const item = document.createElement("li");
        const icon = document.createElement("span");
        icon.className = "moon-mini";
        icon.style.backgroundImage = `url("${moonImage(event.phase)}")`;
        const text = document.createElement("span");
        const title = document.createElement("strong");
        title.textContent = event.name;
        const time = document.createElement("time");
        time.dateTime = event.iso;
        time.textContent = event.whenLabel;
        text.append(title, time);
        item.append(icon, text);
        return item;
      }),
    );
  }
</script>
