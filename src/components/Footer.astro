---
import site from "../data/site.json";
import { sitePath } from "../lib/paths";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <h2>{site.name}</h2>
      <p>
        {site.addressLines[0]}<br />
        {site.addressLines[1]}
      </p>
      <p>{site.greeting}</p>
    </div>
    <div>
      <h2>Dane koła</h2>
      <p>
        REGON: {site.regon}<br />
        NIP: {site.nip}
      </p>
    </div>
    <div>
      <h2>Na stronie</h2>
      <ul>
        <li><a href={sitePath("/aktualnosci/")}>Aktualności</a></li>
        <li><a href={sitePath("/galeria/")}>Galeria</a></li>
        <li><a href={sitePath("/zarzad/")}>Zarząd</a></li>
        <li><a href={sitePath("/ksiazka-polowan/")}>Książka polowań</a></li>
      </ul>
    </div>
  </div>
</footer>
