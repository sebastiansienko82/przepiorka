---
import site from "../data/site.json";

const links = [
  { href: "/aktualnosci/", label: "Aktualności" },
  { href: "/galeria/", label: "Galeria" },
  { href: "/zarzad/", label: "Zarząd" },
  { href: "/ksiazka-polowan/", label: "Książka polowań" },
];

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/">
    <img src={site.logo} alt="" width="80" height="80" />
    <span class="brand-text">
      <strong>Przepiórka</strong>
      <span>Koło łowieckie w Księżynie</span>
    </span>
  </a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
  <nav aria-label="Główne">
    <ul id="menu" class="nav-list">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={pathname === link.href || pathname.startsWith(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const menu = document.querySelector("#menu");
  button?.addEventListener("click", () => {
    const open = menu?.classList.toggle("is-open") ?? false;
    button.setAttribute("aria-expanded", String(open));
  });
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) {
      menu.classList.remove("is-open");
      button?.setAttribute("aria-expanded", "false");
    }
  });
</script>
